config_version=5
[application]
config/name="Little Adventurer Guild"
config/use_custom_user_dir=true
config/custom_user_dir_name="GuaSampleGuild2D"
run/main_scene="res://main.tscn"
[display]
window/size/viewport_width=1100
window/size/viewport_height=760
window/size/window_width_override=1100
window/size/window_height_override=760
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.04,0.07,0.11,1)
